#!/usr/bin/env python3
"""Launch a benchmark-driven rewrite investigation with Claude or Codex."""
import argparse
import json
import os
from pathlib import Path
import shutil
import sys


ROOT = Path(__file__).resolve().parents[1]


TASK = """
Find string benchmarks where cvc5 loses to the external solver, then investigate
whether missing rewrites could help. Use the configuration below.

Follow tools/metagraphe/README.md, its rewrite_db/README.md and
docs/maintenance.md. Respect existing changes.

1. Record binary versions/hashes and commands; verify the external string backend
   (including Noodler selection when applicable). Select a reproducible sample
   across the configured logics and families, up to max_benchmarks.
2. Run both solvers on identical inputs with equal time/memory limits, sequentially.
   Separate solved results, timeouts, unknown, unsupported inputs and errors;
   quarantine answer disagreements. Rank external-only solves and substantial
   runtime gaps, then confirm diverse leads using the configured repetitions and
   confirmation timeout. Report coverage and reverse wins too.
3. Reduce promising cases and propose explicit lhs -> rhs rules with sorts and
   side conditions. Orient complex -> simpler, prioritizing costly-operator
   elimination before term size. Check semantic validity and matching cvc5
   source/RARE rules before claiming a rule is missing. Distinguish known-rule
   applicability and solver-strategy gaps. Where justified, compare original and
   rewritten scratch inputs; keep validity, availability and speedup claims separate.
4. Write a concise ranked assessment with reproduction commands, evidence and
   next tests in the project ledger. File concrete candidates through the existing
   rewrite database workflow. Keep raw output under scratch/metagraphe-compare/;
   retain curated evidence under the repository policy. Run required local checks.

Leave solver code/binaries and the original corpus unchanged. Do not commit,
report upstream or publish. Do not invoke this launcher recursively.
"""


def positive_int(value):
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("must be a positive integer")
    if number <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def absolute_path(value):
    if not value.strip():
        raise argparse.ArgumentTypeError("path must not be empty")
    try:
        return str(Path(value).expanduser().resolve())
    except (OSError, RuntimeError) as exc:
        raise argparse.ArgumentTypeError(str(exc))


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        epilog="Launches in this tachyon checkout. Paths resolve relative to the "
               "caller's directory; quoted ~ is expanded. --show-prompt needs "
               "neither installed agents nor existing solver/corpus paths.",
    )
    agents = parser.add_mutually_exclusive_group()
    agents.add_argument("--claude", dest="agent", action="store_const", const="claude",
                        help="use Claude (default)")
    agents.add_argument("--codex", dest="agent", action="store_const", const="codex",
                        help="use Codex")
    parser.set_defaults(agent="claude")
    parser.add_argument("--print", dest="print_response", action="store_true",
                        help="run non-interactively and print the agent's response")
    parser.add_argument("--show-prompt", action="store_true",
                        help="print the prompt without launching anything")
    parser.add_argument("--benchmarks-dir", type=absolute_path,
                        default="~/benchmarks/smt-lib-2026/", help="SMT-LIB root or subset")
    parser.add_argument("--cvc5-binary", type=absolute_path,
                        default="~/bin/ajr-cvc5", help="cvc5 executable path")
    parser.add_argument("--external-binary", type=absolute_path,
                        default="~/bin/z3noodler", help="comparison solver executable path")
    parser.add_argument("--cvc5-source", type=absolute_path,
                        help="optional source checkout to match against cvc5")
    parser.add_argument("--cvc5-arg", action="append", default=[], metavar="ARG",
                        help="one literal cvc5 argument; repeat, using = for leading dashes")
    parser.add_argument("--external-arg", action="append", default=[], metavar="ARG",
                        help="one literal external solver argument; repeat as needed")
    parser.add_argument("--logic", action="append", dest="logics", metavar="LOGIC",
                        help="include this logic; repeat (default: QF_S, QF_SLIA, QF_SNIA)")
    parser.add_argument("--max-benchmarks", type=positive_int, default=200,
                        help="maximum number of paired screening inputs")
    parser.add_argument("--timeout-seconds", type=positive_int, default=10,
                        help="screening wall-clock timeout per solver/input")
    parser.add_argument("--shortlist-size", type=positive_int, default=10,
                        help="maximum number of gaps to confirm")
    parser.add_argument("--confirmation-timeout-seconds", type=positive_int, default=60,
                        help="confirmation wall-clock timeout per solver/input")
    parser.add_argument("--confirmation-repeats", type=positive_int, default=3,
                        help="paired repetitions for shortlisted inputs")
    config = vars(parser.parse_args())
    agent = config.pop("agent")
    noninteractive = config.pop("print_response")
    show_prompt = config.pop("show_prompt")
    if config["confirmation_timeout_seconds"] < config["timeout_seconds"]:
        parser.error("--confirmation-timeout-seconds must be at least --timeout-seconds")
    if config["logics"] is None:
        config["logics"] = ["QF_S", "QF_SLIA", "QF_SNIA"]
    config = {key: value for key, value in config.items() if value is not None and value != []}
    settings = ",\n".join("  " + json.dumps(key) + ": " + json.dumps(value)
                          for key, value in config.items())
    prompt = TASK.strip() + "\n\nConfiguration (literal paths and argv values):\n```json\n{\n" + settings + "\n}\n```"
    if show_prompt:
        print(prompt)
        return 0

    executable = shutil.which(agent)
    if executable is None:
        print(parser.prog + ": " + agent + " is not installed or not on PATH", file=sys.stderr)
        return 127
    executable = str(Path(executable).resolve())
    command = [agent]
    if noninteractive:
        command.append("-p" if agent == "claude" else "exec")
    command.append(prompt)
    os.chdir(ROOT)
    try:
        os.execv(executable, command)
    except OSError as exc:
        print(parser.prog + ": could not launch " + agent + ": " + str(exc), file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main())
