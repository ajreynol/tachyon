#!/bin/bash
# submit -- this repository's front end to run-dev's submit.
#   job_launcher/submit [run-dev flags] CONFIG...        CONFIG resolves against job_launcher/configs/
#   job_launcher/submit -n CONFIG...                      dry run (run-dev's -n)
#   job_launcher/submit -b BRANCH [-r | -x CONFIG]        build / regress (run-dev's, unchanged)
#   job_launcher/submit -k NAME...                        close a finished tmux window
#
#   Everything is run-dev's submit -- flags, config variables, checks, refusals,
#   see `job_launcher/submit -h` -- with exactly four things added:
#     * the site file is job_launcher/site.conf (passed as SUBMIT_SITE), never run-dev's;
#     * a bare CONFIG name is looked up in job_launcher/configs/ first;
#     * the log entries run-dev appends to its own log.txt during this call are
#       copied to job_launcher/log.txt, which is the tracked record;
#     * a warning if the run-dev checkout is not at the commit in run-dev.lock.
#   Anything run-dev writes for itself (configs/.gen/ for --baseline and -x,
#   its own log.txt) it still writes there.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common.sh
source "$HERE/common.sh"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,16p' "$0"; echo; echo "---- run-dev's submit -h:"; exec "$RUN_DEV/submit" -h
fi

# Resolve bare config names.  The argument after -b/--build is a branch and is
# never a config; anything else that names a file in job_launcher/configs/ is one.
ARGS=(); PREV=""
for A in "$@"; do
  if [ -f "$HERE/configs/$A" ] && [ "$PREV" != "-b" ] && [ "$PREV" != "--build" ]; then
    ARGS+=("$HERE/configs/$A")
  else
    ARGS+=("$A")
  fi
  PREV=$A
done

RDLOG=$RUN_DEV/log.txt
lines() { [ -f "$1" ] && echo $(( $(wc -l < "$1") )) || echo 0; }
BEFORE=$(lines "$RDLOG")
RC=0
SUBMIT_SITE=$SITE "$RUN_DEV/submit" "${ARGS[@]}" || RC=$?
AFTER=$(lines "$RDLOG")
if [ "$AFTER" -gt "$BEFORE" ]; then
  tail -n +"$((BEFORE + 1))" "$RDLOG" >> "$HERE/log.txt"
  echo "job_launcher: $((AFTER - BEFORE)) log line(s) copied to job_launcher/log.txt"
fi
exit $RC
