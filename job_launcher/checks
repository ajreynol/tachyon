#!/bin/bash
# checks -- lint for this repository; read-only, no ssh, fast.
#   1. every script parses;
#   2. no personal data (username, home directory, git identity, and whatever
#      job_launcher/site.conf names: host, repo, binaries) in any file that could be
#      committed -- the patterns come from the environment at runtime, so this
#      repository never contains them;
#   3. every tracked config resolves against the site template with the
#      variables submit requires set;
#   4. the host scripts in job_launcher/host/ parse and are executable.
#   Run before committing.
set -uo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
cd "$ROOT"

FAIL=0
err()  { echo "FAIL: $*"; FAIL=1; }
note() { echo "  ok: $*"; }

# Public files = tracked + untracked-but-not-ignored.
PUBLIC=$( { git ls-files; git ls-files --others --exclude-standard; } | sort -u )
# The records are exempt from the personal-data check: the launch log and the
# ledger name the host and the binaries on purpose, because a result that does
# not say where and with what it was produced is not a record.
RECORDS='^(job_launcher/log\.txt|tools/[^/]+/ledger/)'
PUBLIC_NONRECORD=$(echo "$PUBLIC" | grep -vE "$RECORDS")

# ---- 1. every script parses -------------------------------------------------
BAD=0
for f in job_launcher/submit job_launcher/status job_launcher/deploy job_launcher/fetch job_launcher/checks job_launcher/common.sh job_launcher/site.conf.example job_launcher/configs/*.conf; do
  bash -n "$f" 2>/dev/null || { err "bash -n fails: $f"; BAD=1; }
done
[ $BAD = 0 ] && note "all scripts and configs parse"

# ---- 2. no personal data in public files ------------------------------------
# URLs are stripped before matching: a link to a public repository is a
# reference, not a leak.  Everything else is matched case-insensitively.
PATS=""
addpat() { [ -n "${1:-}" ] && [ ${#1} -ge 3 ] && PATS="$PATS $1"; }
addpat "$(whoami)"
addpat "$(basename "$HOME")"
addpat "$(git config user.email 2>/dev/null | cut -d@ -f1)"
# The git user's name is deliberately not a pattern: a research repository
# cites its author's papers by name.  Usernames, home directories and the
# email's local part are machine identity and stay patterns.
if [ -f job_launcher/site.conf ]; then
  # The shipped placeholders (including cvc5) are public defaults, not identity.
  TEMPLATE_PATTERNS=$( source job_launcher/site.conf.example
                       printf '%s\n' "$DEFAULT_HOST" "$REPO_BINARY" "${REPO##*/}" )
  DEFAULT_HOST=""; REPO=""; REPO_BINARY=""; CVC5_BIN=""; Z3_BIN=""
  # shellcheck disable=SC1091
  source job_launcher/site.conf 2>/dev/null || true
  # Host, repo and binary names are personal; the benchmark set's name is not
  # (the research project has to be able to say which set it is about).
  for P in "$DEFAULT_HOST" "$REPO_BINARY" "${REPO##*/}"; do
    if ! grep -Fx -- "$P" <<< "$TEMPLATE_PATTERNS" >/dev/null; then addpat "$P"; fi
  done
  # CVC5_BIN / Z3_BIN are versions or build names, not personal; not patterns.
fi
BAD=0
for P in $PATS; do
  HITS=""
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    # Read the whole stream: grep -q can SIGPIPE sed under pipefail, hiding a hit.
    sed -E 's#https?://[^ )>]+##g' "$f" | grep -iwF -- "$P" >/dev/null && HITS="$HITS $f"
  done <<< "$PUBLIC_NONRECORD"
  [ -z "$HITS" ] || { err "personal pattern '$P' appears in:$HITS"; BAD=1; }
done
[ $BAD = 0 ] && note "no personal data in public files ($(echo $PATS | wc -w | tr -d ' ') patterns checked; records exempt)"

# ---- 3. every tracked config resolves against the site template ------------
BAD=0
for c in job_launcher/configs/*.conf; do
  OUT=$( set -u; DEFAULT_HOST=""; DEFAULT_SESSION=""; REPO=""; BUILDDIR=""; REPO_BINARY=""
         source job_launcher/site.conf.example >/dev/null 2>&1 || { echo "site template does not source"; exit 1; }
         COMMENT=""; NAME=""; TAG=""; DIR=""; DRIVER=""; TIMEOUT=""; BENCH=""; BINARY=""; SCRIPT=""; OPTS=""; CMD=""; BRANCH=""
         source "$c" 2>&1 || { echo "config does not source"; exit 1; }
         [ -n "$COMMENT" ] || echo "COMMENT is empty"
         [ -n "$DIR" ]     || echo "DIR is empty"
         [ -n "$CMD" ] || { [ -n "$DRIVER" ] || echo "DRIVER is empty"; [ -n "$BINARY" ] || echo "BINARY is empty"; }
         set_prefix "$DIR" >/dev/null || echo "set_prefix knows no prefix for DIR=$DIR" )
  # DIR resolves to the template's value, which is a ~ path by design; only a
  # literal path in the config itself is a defect, so re-check the source text.
  grep -qE '^DIR=[~/]' "$c" && OUT="$OUT
DIR is a literal path in the config"
  OUT=$(echo "$OUT" | sed "/^$/d")
  [ -z "$OUT" ] || { err "$c: $(echo "$OUT" | tr '\n' ';')"; BAD=1; }
done
[ $BAD = 0 ] && note "all configs resolve against job_launcher/site.conf.example"

# ---- 4. the host scripts ----------------------------------------------------
# These are deployed to ~/bin/heuresis by job_launcher/deploy and run on the
# benchmark host, so a syntax error here only shows up mid-job.
HBAD=0
for f in job_launcher/host/benchmark_binary job_launcher/host/solve_dir_rec_par_cvc5 \
         job_launcher/host/solve_dir_rec_par_z3 job_launcher/host/stats_dir_rec_par_cvc5 \
         job_launcher/host/cvc5_solve.sh job_launcher/host/z3_solve.sh; do
  [ -f "$f" ] || { echo "FAIL: missing $f"; FAIL=1; HBAD=1; continue; }
  bash -n "$f" 2>/dev/null || { echo "FAIL: $f does not parse"; FAIL=1; HBAD=1; }
  [ -x "$f" ] || { echo "FAIL: $f is not executable"; FAIL=1; HBAD=1; }
done
[ -f job_launcher/host/heuresis.conf.example ] || { echo "FAIL: missing job_launcher/host/heuresis.conf.example"; FAIL=1; HBAD=1; }
if grep -rl 'bin/run-dev' job_launcher/host job_launcher/submit job_launcher/status 2>/dev/null | grep -q .; then
  echo "FAIL: a launcher path (~/bin/run-dev) is still referenced; this repository is meant to be self-contained"; FAIL=1; HBAD=1
fi
[ $HBAD = 0 ] && note "host scripts parse, are executable, and reference no external launcher"

[ $FAIL = 0 ] && echo "checks: all passed" || { echo "checks: FAILED"; exit 1; }
