      "priority": 1,
      "proposal": {
        "rewrites": [
          {
            "variables": {
              "s": "String or Seq(T)",
              "u": "same sort as s",
              "r": "same sort as s"
            },
            "lhs": "(str.contains (str.replace_all s u r) u)",
            "rhs": "(and (str.contains s u) (str.contains r u))",
            "condition": "(= (str.len u) 1)",
            "notation": "SMT-LIB term schema"
          }
        ],
        "rare_drafts": [
          "(define-rule metagraphe-contains-replace-all-unit\n  ((s ?Seq) (r ?Seq) (x ?))\n  (str.contains (str.replace_all s (seq.unit x) r) (seq.unit x))\n  (and (str.contains s (seq.unit x))\n       (str.contains r (seq.unit x))))",
          "(define-cond-rule metagraphe-contains-replace-all-char\n  ((s ?Seq) (u ?Seq) (r ?Seq))\n  (= (str.len u) 1)\n  (str.contains (str.replace_all s u r) u)\n  (and (str.contains s u) (str.contains r u)))"
        ],
        "application_context": "Local term rewriting; normalized matching remains to be tested."
      },
      "schema_version": 1,
      "theories": [
        "sequences",
        "strings"
      ]
