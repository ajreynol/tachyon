#!/usr/bin/env python3
"""arms -- the register's reading of an arm: gained, lost and net against a cvc5 reference.

    tools/heuresis/reports/arms [--timeout 30] [--md] REFERENCE=RESULTS LABEL=RESULTS ...

The first LABEL=RESULTS is the reference, the run a `± solved` cell in
directions.md is subtracted from; every other run is an arm read against it.
Results files are read by `gap`'s own reader, so solved, timeout and PAR2 mean
exactly what they mean there:
  solved      result is sat or unsat, in under --timeout
  gained      benchmarks the arm solves and the reference does not
  lost        benchmarks the reference solves and the arm does not
  net         gained - lost; the register's marker is chosen from gained and net
  crash       result is error, or none (the wrapper's token for empty output)
  disagree    one run says sat and the other unsat -- a soundness question
Runs must cover exactly the same benchmarks; anything else is refused, because
an arm over a different cohort does not measure the change it names.  Nothing
is modified.  No dependencies beyond Python 3.
"""
import argparse
import importlib.machinery
import importlib.util
import math
import sys
from pathlib import Path

_GAP = Path(__file__).resolve().parent / 'gap'
_SPEC = importlib.util.spec_from_loader('gap', importlib.machinery.SourceFileLoader('gap', str(_GAP)))
gap = importlib.util.module_from_spec(_SPEC)
_SPEC.loader.exec_module(gap)
SOLVED = gap.SOLVED
CRASH = {'error', 'none'}


def load(path, timeout):
    """-> dict benchmark -> (status, seconds), with slow solves counted as timeouts."""
    res, _ = gap.read(path)
    return {b: ('timeout' if r in SOLVED and t >= timeout else r, t) for b, (r, t, _m) in res.items()}


def summary(res, timeout):
    """-> solved, unknown, timeout, crash counts and PAR2 over one run."""
    statuses = [r for r, _ in res.values()]
    par2 = sum(t if r in SOLVED else 2 * timeout for r, t in res.values())
    return (sum(r in SOLVED for r in statuses), statuses.count('unknown'),
            statuses.count('timeout'), sum(r in CRASH for r in statuses), par2)


def compare(ref, arm):
    """-> gained, lost, disagree: benchmark sets of an arm against its reference."""
    gained = {b for b in arm if arm[b][0] in SOLVED and ref[b][0] not in SOLVED}
    lost = {b for b in arm if ref[b][0] in SOLVED and arm[b][0] not in SOLVED}
    disagree = {b for b in arm if {arm[b][0], ref[b][0]} == SOLVED}
    return gained, lost, disagree


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('runs', nargs='+', metavar='LABEL=RESULTS')
    ap.add_argument('--timeout', type=float, default=30.0)
    ap.add_argument('--md', action='store_true', help='a markdown table (for a ledger entry)')
    a = ap.parse_args()
    if not math.isfinite(a.timeout) or a.timeout <= 0:
        ap.error('--timeout must be finite and positive')
    if len(a.runs) < 2:
        ap.error('give a reference and at least one arm')
    runs = []
    for spec in a.runs:
        label, _, path = spec.partition('=')
        if not label or not path:
            ap.error(f'expected LABEL=RESULTS, got {spec!r}')
        try:
            runs.append((label, load(path, a.timeout)))
        except (OSError, ValueError) as error:
            ap.error(str(error))
    ref_label, ref = runs[0]
    for label, res in runs[1:]:
        if set(res) != set(ref):
            ap.error(f'{label} covers {len(res)} benchmarks and {ref_label} {len(ref)}, not the same set')

    def row(cells):
        return ('| ' + ' | '.join(str(c) for c in cells) + ' |') if a.md else '  '.join(f'{str(c):>9}' for c in cells)

    print(row(['run', 'gained', 'lost', 'net', 'solved', 'unknown', 'timeout', 'crash', 'disagree', 'PAR2']))
    if a.md:
        print(row(['---'] + ['---:'] * 9))
    solved, unknown, timeouts, crashes, par2 = summary(ref, a.timeout)
    print(row([ref_label, '', '', '', solved, unknown, timeouts, crashes, '', f'{par2:.1f}']))
    for label, res in runs[1:]:
        gained, lost, disagree = compare(ref, res)
        solved, unknown, timeouts, crashes, par2 = summary(res, a.timeout)
        print(row([label, f'+{len(gained)}', f'-{len(lost)}', f'{len(gained) - len(lost):+d}',
                   solved, unknown, timeouts, crashes, len(disagree), f'{par2:.1f}']))
    return 0


if __name__ == '__main__':
    sys.exit(main())
