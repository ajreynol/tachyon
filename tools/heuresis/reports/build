#!/usr/bin/env python3
"""report -- build heuresis's public gap report from the evidence this project tracks.

    tools/heuresis/reports/build --out DIR [--base-url URL] [--repo-url URL]

Reads three tracked things and nothing else: the gap lists retained beside this
script under `data/`, the ledger entries in `docs/ledger/` that cite them, and
the protocol and history tables of `docs/progress.md`.  Every figure on the page is either read from that
evidence or computed from a gap list on the spot, so the site cannot state a
number the ledger does not.  A gap list no ledger entry cites is refused rather
than published, as are malformed rows, because a published number with no
recorded experiment behind it is exactly what this project forbids.

Writes `index.html` and `data/<id>.csv` under --out, rewritten whole, and prints
one JSON object on stdout describing the report for whoever assembles the site
(`scripts/build_site.py` here; see docs/site.md for the contract).  Progress
notes go to stderr.  Python standard library only; no network access.
"""
import argparse
import csv
import html
import json
import posixpath
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
TEMPLATE = HERE / "report.html"
QUEUE_TEMPLATE = HERE / "queue.html"
DEFAULT_REPO = "https://github.com/ajreynol/tachyon"
DEFAULT_URL = "https://ajreynol.github.io/tachyon/heuresis"
# The gap list names its arms: gapset-<cvc5 arm>-vs-<reference>[-<date>].txt
NAME = re.compile(r"^gapset-(?P<arm>.+?)-vs-(?P<reference>.+?)\.txt$")
TITLE = re.compile(r"^#\s*(\d{4}-\d{2}-\d{2})\s*[—-]\s*(.+?)\s*$")
# Each direction states its own risk and gain before it argues for itself.
# The badge is the claim the register makes at a glance, so the page carries
# it rather than a summary somebody here wrote.
EFFORT = re.compile(r"^\*\*Effort\.\*\*\s*(.+?)\s*(?:—|--)", re.MULTILINE | re.DOTALL)
LINK = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")


def read_gapset(path):
    """-> [(benchmark, reference seconds, run seconds or None if unsolved)].

    The format is `gap --gapset`'s: one line per benchmark, the reference time,
    then the run's time or the status token that says it never answered.
    """
    rows, seen = [], set()
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) != 3:
            raise ValueError(f"{path.name}:{number}: expected 'benchmark reference run', got {line!r}")
        benchmark, reference, run = fields
        if benchmark in seen:
            raise ValueError(f"{path.name}:{number}: repeated benchmark {benchmark}")
        seen.add(benchmark)
        try:
            reference = float(reference)
        except ValueError:
            raise ValueError(f"{path.name}:{number}: reference time {reference!r} is not a number") from None
        try:
            run = float(run)
        except ValueError:
            run = None  # a status token: the run never reported a time
        if reference < 0 or (run is not None and run < 0):
            raise ValueError(f"{path.name}:{number}: negative time")
        rows.append((benchmark[2:] if benchmark.startswith("./") else benchmark, reference, run))
    if not rows:
        raise ValueError(f"{path.name}: no benchmarks in the gap list")
    return rows


def entries(ledger):
    """-> [{path, date, title, text}] for the ledger entries, newest first."""
    found = []
    for path in sorted(ledger.glob("2*.md")):
        text = path.read_text()
        match = TITLE.match(text.splitlines()[0] if text else "")
        if not match:
            raise ValueError(f"{path.name}: the first line must be '# YYYY-MM-DD — title'")
        found.append({"path": path, "date": match.group(1), "title": match.group(2), "text": text})
    if not found:
        raise ValueError(f"{ledger}: no ledger entries")
    return sorted(found, key=lambda e: (e["date"], e["path"].name), reverse=True)


def cited_by(entry_list, name):
    """The newest ledger entry citing this gap list; a list none cites is refused."""
    citing = [entry for entry in entry_list if name in entry["text"]]
    if not citing:
        raise ValueError(f"{name}: no ledger entry cites this gap list; it cannot be published")
    return citing[0]


def command(texts, driver, token):
    """The recorded command whose job name ends in `token`, and its solver revision.

    The ledger quotes what was run, so an arm's options are read from there and
    never restated here. The job name always follows the wrapper script on a
    driver command line, which is what this anchors on.
    """
    pattern = re.compile(rf"^{driver}\s+.*?\S+_solve\.sh\s+(\S*{re.escape(token)})\s+(.*)$", re.MULTILINE)
    for text in texts:
        match = pattern.search(text)
        if not match:
            continue
        revision = re.search(r"#\s*(?:cvc5|z3):\s*git\s+(\S+)", text[match.end():match.end() + 200])
        return match.group(2).strip() or None, revision.group(1) if revision else None
    return None, None


def recorded(entry, entry_list, driver, token, date):
    """An arm's options: the citing entry first, then the run's exact job name.

    A gap list can be cited by an entry that did not itself quote that arm --
    a statistics run, or a control first run a day earlier. Looking the exact
    job name up across the ledger finds the command in that case; when nothing
    matches, the report names the job and leaves the options to the entry.
    """
    options, revision = command([entry["text"]], driver, token)
    if options is None and date:
        elsewhere = [entry["text"]] + [other["text"] for other in entry_list if other is not entry]
        options, revision = command(elsewhere, driver, f"quant-{date}-{token}")
    return options, revision


def blob(repo_url, path):
    return f"{repo_url}/blob/main/{path}"


def resolve(repo_url, source, target):
    """A relative Markdown link, as a link into the repository."""
    if target.startswith(("http://", "https://", "#")):
        return target
    return blob(repo_url, posixpath.normpath(posixpath.join(posixpath.dirname(source), target)))


def cell(text, repo_url, source):
    """A Markdown table cell: plain text, one link, or a run of both."""
    plain = text.replace("**", "").replace("`", "").strip()
    parts, end = [], 0
    for match in LINK.finditer(plain):
        if match.start() > end:
            parts.append(plain[end:match.start()])
        parts.append({"text": match.group(1), "href": resolve(repo_url, source, match.group(2))})
        end = match.end()
    if not parts:
        return plain
    if end < len(plain):
        parts.append(plain[end:])
    return parts[0] if len(parts) == 1 else parts


def markup(text, repo_url, source):
    """A Markdown paragraph as HTML, escaped first so only these tags survive.

    The input is a tracked document in this repository, and everything in it is
    escaped before any tag is put back, so a footnote cannot smuggle markup into
    the page.
    """
    out = html.escape(" ".join(text.split()))
    out = LINK.sub(lambda m: f'<a href="{resolve(repo_url, source, m.group(2))}">{m.group(1)}</a>', out)
    out = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"`(.+?)`", r"<code>\1</code>", out)
    return re.sub(r"(?<![*\w])\*(?!\s)(.+?)(?<!\s)\*(?![*\w])", r"<em>\1</em>", out)


def notes(lines, repo_url, source):
    """The prose the history section carries beneath its table."""
    blocks, block = [], []
    for line in lines + [""]:
        if line.strip():
            block.append(line.strip())
            continue
        if block:
            joined = " ".join(block)
            if joined.startswith("#"):
                blocks.append({"heading": joined.lstrip("# ").strip()})
            else:
                blocks.append({"paragraph": markup(joined, repo_url, source)})
            block = []
    return blocks


def table(lines, repo_url, source):
    rows = [[c.strip() for c in line.strip().strip("|").split("|")] for line in lines]
    columns = [cell(c, repo_url, source) for c in rows[0]]
    body = [[cell(c, repo_url, source) for c in row] for row in rows[2:]]
    return columns, body


def progress(path, repo_url, source):
    """The fixed protocol and the history table, read from docs/progress.md.

    These are the project's own recorded figures. Parsing them keeps the report
    and the document a single source: if the document stops saying what the set
    or the protocol is, the build fails instead of publishing a stale copy.
    """
    text = path.read_text()
    protocol = {}
    for key, pattern in (("name", r"^\|\s*set\s*\|\s*`([^`]+)`"),
                         ("size", r"^\|\s*set\s*\|.*?\*\*([\d,]+)\s+benchmarks\*\*"),
                         ("timeout", r"^\|\s*timeout\s*\|\s*([\d.]+)\s*s"),
                         ("factor", r"^\|\s*reading\s*\|.*?factor\s+([\d.]+)"),
                         ("floor", r"^\|\s*reading\s*\|.*?floor\s+([\d.]+)\s*s")):
        match = re.search(pattern, text, re.MULTILINE)
        if not match:
            raise ValueError(f"{path.name}: the protocol table does not state the {key}")
        protocol[key] = match.group(1)
    protocol["size"] = int(protocol["size"].replace(",", ""))
    protocol["timeout"] = float(protocol["timeout"])
    protocol["factor"] = float(protocol["factor"])
    protocol["floor"] = float(protocol["floor"])

    section = re.search(r"^## The history\s*$(.*?)^## ", text, re.MULTILINE | re.DOTALL)
    if not section:
        raise ValueError(f"{path.name}: no '## The history' section")
    body = section.group(1).splitlines()
    lines = [line for line in body if line.strip().startswith("|")]
    if len(lines) < 3:
        raise ValueError(f"{path.name}: the history section has no table of rows")
    columns, rows = table(lines, repo_url, source)
    tail = body[body.index(lines[-1]) + 1:]
    return protocol, {"columns": columns, "rows": rows, "notes": notes(tail, repo_url, source)}


def summarize(rows):
    factors = sorted(run / max(reference, 1e-3) for _, reference, run in rows if run is not None)
    unsolved = sum(1 for _, _, run in rows if run is None)
    return {"gap": len(rows), "unsolved": unsolved, "slower": len(factors),
            "median": factors[(len(factors) - 1) // 2] if factors else None,
            "widest": factors[-1] if factors else None}


def comparisons(root, entry_list, repo_url):
    found = []
    for path in sorted((root / "reports/data").glob("gapset-*.txt")):
        match = NAME.match(path.name)
        if not match:
            raise ValueError(f"{path.name}: expected gapset-<arm>-vs-<reference>.txt")
        arm, reference = match.group("arm"), match.group("reference")
        entry = cited_by(entry_list, path.name)
        rows = read_gapset(path)
        stamp = re.search(r"-(\d{6})$", reference)
        stamp = stamp.group(1) if stamp else None
        options, revision = recorded(entry, entry_list, "solve_dir_rec_par_cvc5", arm, stamp)
        z3_options, _ = recorded(entry, entry_list, "solve_dir_rec_par_z3", reference, None)
        found.append({
            "id": f"{arm}-vs-{reference}",
            "label": entry["title"],
            "date": entry["date"],
            "arm": {"job": arm, "options": options, "revision": revision},
            "reference": {"job": reference, "options": z3_options, "revision": None},
            "ledger": {"text": entry["path"].name, "href": blob(repo_url, f"tools/heuresis/docs/ledger/{entry['path'].name}")},
            "source": {"text": path.name, "href": blob(repo_url, f"tools/heuresis/reports/data/{path.name}")},
            "csv": f"data/{arm}-vs-{reference}.csv",
            "summary": summarize(rows),
            "rows": [[benchmark, round(reference_s, 3), -1 if run is None else round(run, 3)]
                     for benchmark, reference_s, run in rows],
        })
    if not found:
        raise ValueError("no retained gap lists under reports/data/")
    # Newest first; where a date holds several lists, the smallest gap set leads,
    # so the page opens on the strongest recorded configuration of that day.
    found.sort(key=lambda c: (c["date"], -c["summary"]["gap"]), reverse=True)
    labels = [c["label"] for c in found]
    for item in found:
        if labels.count(item["label"]) > 1:
            item["label"] = f"{item['label']} ({item['id'].split('-vs-')[0]})"
    return found


def sections(todo, repo_url, source):
    """Every `## ` section of docs/todo.md, as its prose and its one table.

    The queue page is that document, rendered: the short-term goals, the two
    separate rankings and the branch assessment. Reading it rather than
    restating it is what stops the page and the document drifting apart -- and
    a section that loses its table is a refusal, not a page with a hole in it.
    """
    found = []
    for match in re.finditer(r"^##\s+(.+?)\s*$(.*?)(?=^##\s|\Z)", todo, re.MULTILINE | re.DOTALL):
        heading, body = match.group(1), match.group(2)
        lines = [line for line in body.splitlines() if line.strip().startswith("|")]
        if len(lines) < 3:
            raise ValueError(f"{source}: section '{heading}' no longer carries a table")
        columns, body_rows = table(lines, repo_url, source)
        prose = notes([line for line in body.splitlines()[:body.splitlines().index(lines[0])]],
                      repo_url, source)
        found.append({"heading": heading, "prose": prose,
                      "columns": columns, "rows": body_rows})
    if not found:
        raise ValueError(f"{source}: no '## ' sections to publish")
    return found


def render_cell(value):
    """One parsed Markdown cell -- plain text, a link, or a run of both."""
    if isinstance(value, str):
        return html.escape(value)
    if isinstance(value, dict):
        return f'<a href="{html.escape(value["href"])}">{html.escape(value["text"])}</a>'
    return "".join(render_cell(part) for part in value)


def render_section(item):
    prose = "".join(f'<p class="muted">{block["paragraph"]}</p>'
                    for block in item["prose"] if "paragraph" in block)
    ranked = item["columns"] and item["columns"][0] in ("rank", "#")
    def attr(index):
        if ranked and index == 0:
            return ' class="rank"'
        return ' class="wrap"' if index else ""
    head = "".join(f"<th{attr(i)}>{render_cell(c)}</th>" for i, c in enumerate(item["columns"]))
    rows = "".join("<tr>" + "".join(f"<td{attr(i)}>{render_cell(c)}</td>"
                                    for i, c in enumerate(row)) + "</tr>"
                   for row in item["rows"])
    return (f'<section>\n<h2>{html.escape(item["heading"])}</h2>\n{prose}\n'
            f'<div class="tablewrap"><table><thead><tr>{head}</tr></thead>'
            f"<tbody>{rows}</tbody></table></div>\n</section>")


def landed(path):
    """How many pull requests progress.md records as having reached cvc5 main.

    The document keeps the table whether or not anything is in it, so the page
    reads the row count rather than stating a zero of its own -- the one figure
    on this page that would otherwise be typed in, and the one this project
    most wants nobody to be able to soften.
    """
    body = re.search(r"^## Pull requests to cvc5 main\s*$(.*?)(?=^## |\Z)",
                     path.read_text(), re.MULTILINE | re.DOTALL)
    if not body:
        raise ValueError(f"{path.name}: no '## Pull requests to cvc5 main' section")
    lines = [line.strip() for line in body.group(1).splitlines() if line.strip().startswith("|")]
    if len(lines) < 3:
        raise ValueError(f"{path.name}: the pull-request section has no table")
    count = 0
    for line in lines[2:]:
        first = line.strip("|").split("|")[0].replace("*", "").replace("(none yet)", "").strip()
        count += bool(first)
    return count


def slug(heading):
    """A heading's anchor, the way the renderer makes one.

    Runs of spaces are *not* collapsed: these headings separate the identifier
    from the title with an em dash, which is dropped, leaving two spaces and so
    a double hyphen in the anchor. Collapsing them produces a link that resolves
    nowhere, and nothing would catch it because these anchors are generated.
    """
    return re.sub(r"[^\w\s-]", "", heading.lower()).replace(" ", "-")


def plain(value):
    return re.sub(r"<[^>]+>", "", render_cell(value)).strip()


def ranking(found, heading):
    """{direction: rank} from one of the two ranking tables in docs/todo.md."""
    out = {}
    for row in named(found, heading):
        match = re.search(r"\b(R\d+)\b", plain(row[1]))
        if not match:
            raise ValueError(f"docs/todo.md: a '{heading}' row names no research direction")
        out[match.group(1)] = plain(row[0])
    return out


def register(text, source, repo_url, agent, maintainer):
    """Every direction the register defines, with its effort and both ranks.

    The rankings publish ten each; this publishes all of them, so what was left
    out is as visible as what was chosen. The two ranks stay in their own
    columns for the reason the whole project keeps them apart: one is this
    project's, the other is the maintainer's, and a single merged column would
    quietly attribute each to nobody. A direction that states no effort is
    refused rather than shown blank -- the badge is the register's own claim,
    and an empty cell reads as *no risk* rather than as *not written down*.
    """
    parts = re.split(r"^##\s+(R\d+\b.*?)\s*$", text, flags=re.MULTILINE)
    rows = []
    for heading, body in zip(parts[1::2], parts[2::2]):
        identifier = heading.split()[0]
        effort = EFFORT.search(body)
        if not effort:
            raise ValueError(f"{source}: {identifier} states no '**Effort.**' risk and gain")
        href = resolve(repo_url, source, "directions.md#" + slug(heading))
        unranked = '<span class="muted">&mdash;</span>'
        rows.append([
            '<a href="{}">{}</a>'.format(html.escape(href), html.escape(heading)),
            markup(effort.group(1), repo_url, source),
            html.escape(agent.get(identifier, "")) or unranked,
            html.escape(maintainer.get(identifier, "")) or unranked,
        ])
    if not rows:
        raise ValueError(f"{source}: no '## R<n>' directions to publish")
    return rows


def named(found, heading):
    for item in found:
        if item["heading"] == heading:
            return item["rows"]
    raise ValueError(f"docs/todo.md: no '## {heading}' section to count")


def next_steps(found, repo_url, limit=5):
    """The head of the agent ranking, for the gap report to carry.

    The gap report says where cvc5 loses time; without this it does not say what
    anybody intends to do about it, and the two live in different documents. The
    rows are the ranking's own, truncated rather than rewritten, and the page
    links the whole queue beside them so the truncation cannot read as the list.
    """
    ranked = named(found, "AI-agent priorities")
    columns = ("Rank", "Research direction", "Effort", "Next possible step")
    # str.format rather than an f-string: a backslash inside an f-string
    # expression needs Python 3.12, and this repository runs on 3.9.
    rank, wrap = ' class="rank"', ' class="wrap"'
    head = "".join("<th{}>{}</th>".format(rank if not i else "", name)
                   for i, name in enumerate(columns))
    body = "".join(
        "<tr>" + "".join("<td{}>{}</td>".format(rank if not i else wrap, render_cell(cell))
                         for i, cell in enumerate(row)) + "</tr>"
        for row in ranked[:limit])
    return ("<table><thead><tr>{}</tr></thead><tbody>{}</tbody></table>".format(head, body),
            len(ranked), min(limit, len(ranked)))


def queue_page(found, data, canonical, title, description, merged, directions):
    goals = named(found, "Short-term goals")
    closed = sum(1 for row in goals if "\u2705" in render_cell(row[0]))
    ranked = len(named(found, "AI-agent priorities"))
    tiles = [("research directions", len(directions), "read from cvc5 and z3 source"),
             ("ranked in the queue", ranked,
              f"of {len(directions)}, by the agent"),
             ("short-term goals open", f"{len(goals) - closed} of {len(goals)}",
              "each closed by a ledger entry, not a judgement"),
             ("fork branches assessed", len(named(found, "Branch maintenance")),
              "against current upstream main"),
             ("pull requests to cvc5", merged,
              "counted from the project's own record" if merged else "nothing has landed upstream yet")]
    body = QUEUE_TEMPLATE.read_text()
    replacements = {
        "__TITLE__": html.escape(title),
        "__DESCRIPTION__": html.escape(description),
        "__CANONICAL__": html.escape(canonical),
        "__NAV_TITLE__": html.escape(data["nav"]),
        "__SITE_HREF__": html.escape(data["site"]),
        "__REPO_URL__": html.escape(data["repo"]),
        "__PROJECT_URL__": html.escape(data["project"]),
        "__EYEBROW__": html.escape(f"the queue · set {data['set']['name']}"),
        "__TILES__": "".join(
            f'<div class="tile"><span>{html.escape(label)}</span>'
            f'<strong>{html.escape(str(value))}</strong><span>{html.escape(note)}</span></div>'
            for label, value, note in tiles),
        "__LEAD__": "This is the project's working queue, published as it stands in its own documents: what is "
                    "in flight, which research directions the agent ranks highest and why, the separate "
                    "ranking the human maintainer owns, and which branches of the fork are worth maintaining. "
                    "Everything here is a plan or an assessment. The "
                    '<a href="index.html">gap report</a> is where the measurements are.',
        "__SECTIONS__": "\n\n".join(render_section(item) for item in found),
        "__REGISTER_NOTE__": html.escape(
            f"All {len(directions)} directions, ranked or not. Each ranking above carries ten, so most "
            "of the register sits below both of them: a direction with no rank is one neither list has "
            "reached, not one that has been ruled out. Risk and gain are the register's own qualitative "
            "priors, argued in the entry rather than measured."),
        "__REGISTER__": ("<table><thead><tr><th class=\"wrap\">Direction</th><th>Risk / gain</th>"
                         "<th class=\"rank\">Agent rank</th><th class=\"rank\">Maintainer rank</th>"
                         "</tr></thead><tbody>"
                         + "".join("<tr><td class=\"wrap\">{}</td><td>{}</td>"
                                   "<td class=\"rank\">{}</td><td class=\"rank\">{}</td></tr>".format(*row)
                                   for row in directions)
                         + "</tbody></table>"),
        "__REGISTER_URL__": html.escape(blob(data["repo"], "tools/heuresis/docs/directions.md")),
        "__LIMITS__": "<strong>A rank is not a result.</strong> The agent ranking is this project's own "
                      "assessment and is deliberately kept separate from the maintainer's, which is theirs "
                      "alone; neither is a commitment that any of this work will be done, and neither orders "
                      "the directions by measured benefit. A branch appearing here means somebody wrote code, "
                      "not that it helps \u2014 several rows record branches that were tested and did not earn "
                      "a pull request. Where a row carries a number it came from a ledger entry, and the "
                      "entry is linked from the row.",
        "__FOOTER__": " ".join(
            f'<a href="{html.escape(href)}">{html.escape(text)}</a>' for text, href in (
                ("The charter", data["project"]),
                ("The register of directions", blob(data["repo"], "tools/heuresis/docs/directions.md")),
                ("The queue", blob(data["repo"], "tools/heuresis/docs/todo.md")),
                ("The progress table", blob(data["repo"], "tools/heuresis/docs/progress.md")),
                ("Questions for cvc5", blob(data["repo"], "tools/heuresis/docs/upstream-questions.md")))),
    }
    for token, value in replacements.items():
        if token not in body:
            raise ValueError(f"{QUEUE_TEMPLATE.name}: the template no longer has {token}")
        body = body.replace(token, value)
    return body


def page(data, canonical, title, description):
    body = TEMPLATE.read_text()
    replacements = {
        "__TITLE__": html.escape(title),
        "__DESCRIPTION__": html.escape(description),
        "__CANONICAL__": html.escape(canonical),
        "__NAV_TITLE__": html.escape(data["nav"]),
        "__SITE_HREF__": html.escape(data["site"]),
        "__REPO_URL__": html.escape(data["repo"]),
        "__PROJECT_URL__": html.escape(data["project"]),
        # A JSON island ends at the first "</", so the payload must not carry one.
        "__REPORT_DATA__": json.dumps(data).replace("</", "<\\/"),
        "__NEXT_NOTE__": html.escape(data["next"]["note"]),
        "__NEXT_STEPS__": data["next"]["table"],
        "__REGISTER_URL__": html.escape(data["next"]["register"]),
    }
    for token, value in replacements.items():
        if token not in body:
            raise ValueError(f"{TEMPLATE.name}: the template no longer has {token}")
        body = body.replace(token, value)
    return body


def build(out, base_url, repo_url, site_href="../index.html"):
    out = out.resolve()
    data_dir = (HERE / "data").resolve()
    if out == data_dir or data_dir in out.parents or out in data_dir.parents:
        raise ValueError("the report output must be separate from the recorded evidence")
    base_url = base_url.rstrip("/")
    entry_list = entries(ROOT / "docs/ledger")
    protocol, history = progress(ROOT / "docs/progress.md", repo_url, "tools/heuresis/docs/progress.md")
    found = comparisons(ROOT, entry_list, repo_url)
    latest = found[0]
    project_url = blob(repo_url, "tools/heuresis/README.md")
    queue_sections = sections((ROOT / "docs/todo.md").read_text(), repo_url,
                              "tools/heuresis/docs/todo.md")
    steps, ranked_total, shown = next_steps(queue_sections, repo_url)

    data = {
        "set": {"name": protocol["name"], "size": protocol["size"], "timeout": protocol["timeout"],
                "factor": protocol["factor"], "floor": protocol["floor"]},
        "canonical": f"{base_url}/",
        "nav": "Tachyon / Heuresis",
        "site": site_href,
        "repo": repo_url,
        "project": project_url,
        "comparisons": found,
        "history": {
            "columns": history["columns"], "rows": history["rows"], "notes": history["notes"],
            "note": "One row per cvc5 main revision and tracked configuration, from the project's progress table. "
                    "Every row cites the ledger entry it came from; lower PAR2 and lower ratio are better. "
                    "These rows are the whole corpus, not the gap set above.",
        },
        "next": {
            "table": steps,
            "register": blob(repo_url, "tools/heuresis/docs/directions.md"),
            "note": f"The {shown} research directions this project currently ranks highest, of "
                    f"{ranked_total} in its own ranking, taken from its queue. A rank is an argument "
                    "about what to investigate next, never evidence that doing it would close any of "
                    "the gap above. The human maintainer keeps a separate ranking, and the queue page "
                    "shows both without merging them.",
        },
        "limits": "These are single runs on one execution host, of the recorded cvc5 and z3 revisions with the "
                  "recorded options, on one fixed benchmark set at one timeout. They are not an independent "
                  "replication and not a general claim about either solver. Recomputing a list needs the raw "
                  "results, which stay on the execution host, not this checkout.",
        "footer": [
            {"text": "The charter", "href": project_url},
            {"text": "The ledger", "href": blob(repo_url, "tools/heuresis/docs/ledger/README.md")},
            {"text": "The progress table", "href": blob(repo_url, "tools/heuresis/docs/progress.md")},
            {"text": "Evidence retention", "href": blob(repo_url, "tools/heuresis/reports/data/README.md")},
        ],
    }

    out.mkdir(parents=True, exist_ok=True)
    (out / "data").mkdir(exist_ok=True)
    # A list that is no longer published must not be left behind in an
    # existing output directory, where it would still look current.
    for stale in (out / "data").glob("*.csv"):
        if stale.name not in {Path(item["csv"]).name for item in found}:
            stale.unlink()
    for item in found:
        with (out / item["csv"]).open("w", newline="") as handle:
            writer = csv.writer(handle)
            writer.writerow(["benchmark", "reference_seconds", "cvc5_seconds", "cvc5_status", "slowdown"])
            for benchmark, reference, run in item["rows"]:
                solved = run >= 0
                writer.writerow([benchmark, f"{reference:.2f}", f"{run:.2f}" if solved else "",
                                 "solved" if solved else "unsolved",
                                 f"{run / max(reference, 1e-3):.2f}" if solved else ""])
    title = f"Heuresis reports — where cvc5 is slower than z3 on {protocol['name']}"
    description = (f"Every benchmark in the measured gap between cvc5 and z3 on {protocol['name']}: "
                   f"{latest['summary']['gap']:,} of {protocol['size']:,} benchmarks, with the recorded "
                   "experiment behind each list.")
    (out / "index.html").write_text(page(data, f"{base_url}/", title, description), encoding="utf-8")

    directions = register(
        (ROOT / "docs/directions.md").read_text(), "tools/heuresis/docs/directions.md", repo_url,
        ranking(queue_sections, "AI-agent priorities"),
        ranking(queue_sections, "Human-maintainer priorities"))
    (out / "queue.html").write_text(
        queue_page(queue_sections, data, f"{base_url}/queue.html",
                   "Heuresis — the queue, and why that order",
                   "What heuresis is working on: short-term goals, the agent's ranking of research "
                   "directions, the maintainer's separate ranking, and which fork branches are worth "
                   "maintaining.",
                   landed(ROOT / "docs/progress.md"), directions),
        encoding="utf-8")

    summary = latest["summary"]
    return {
        "name": "heuresis",
        "title": "heuresis",
        "question": "What do quantified benchmarks where z3 is much faster reveal about cvc5?",
        "summary": f"Every benchmark in the measured gap between cvc5 and z3 on {protocol['name']}, "
                   f"one point each, with the ledger entry that produced the list.",
        "href": "index.html",
        "updated": latest["date"],
        "dated": "measured",
        # The first three are what this project has measured; the last two are the
        # pair both research projects answer, so the index can be read across them.
        "headline": [
            {"label": "gap set", "value": f"{summary['gap']:,}", "note": f"of {protocol['size']:,} benchmarks"},
            {"label": "cvc5 unsolved, z3 solved", "value": f"{summary['unsolved']:,}",
             "note": f"within {protocol['timeout']:g} s"},
            {"label": "both solved, cvc5 slower", "value": f"{summary['slower']:,}",
             "note": f"by at least {protocol['factor']:g}×"},
            {"label": "research directions", "value": str(len(directions)),
             "note": "read from cvc5 and z3 source"},
            {"label": "ranked in the queue", "value": str(ranked_total),
             "note": f"of {len(directions)}, by the agent"},
        ],
        "comparisons": len(found),
        "pages": ["index.html", "queue.html"],
        "files": sorted(str(path.relative_to(out)) for path in out.rglob("*") if path.is_file()),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, required=True, help="directory to write the report into")
    parser.add_argument("--base-url", default=DEFAULT_URL, help="where the report will be published")
    parser.add_argument("--repo-url", default=DEFAULT_REPO, help="repository the evidence links point at")
    parser.add_argument("--site-href", default="../index.html", help="relative link back to the site index")
    args = parser.parse_args()
    try:
        summary = build(args.out, args.base_url, args.repo_url, args.site_href)
    except (OSError, ValueError) as error:
        parser.exit(1, f"report: {error}\n")
    print(json.dumps(summary))
    print(f"report: {summary['comparisons']} recorded comparisons -> {args.out.resolve() / 'index.html'}",
          file=sys.stderr)


if __name__ == "__main__":
    main()
