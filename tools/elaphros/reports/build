#!/usr/bin/env python3
"""report -- build elaphros's public planning report from the documents it tracks.

    tools/elaphros/reports/build --out DIR [--base-url URL] [--repo-url URL]

Reads four tracked things and nothing else: the charter in `README.md`, the
ranked queue and planning work in `docs/todo.md`, the register in
`docs/directions.md`, the progress record in `docs/progress.md`, and the
evidence index in `docs/ledger/README.md`.  Every figure on the page is counted
those documents while the page is built, so the site cannot state a number this
project has not recorded -- and cannot state a measurement, because there are
none to state.

What this project publishes is its *reasoning*: which mechanisms it believes are
worth investigating, in what order, on what source evidence, and what it has
refused to claim.  A page that reported a performance number here would be
inventing one.

A document that has stopped carrying the section or the table this reads is a
refusal rather than a stale page: the build fails instead of publishing a copy
that has drifted from the document beside it.

Writes `index.html` under --out, rewritten whole, and prints one JSON object on
stdout describing the report for whoever assembles the site (`scripts/build_site.py`
here; see docs/site.md for the contract).  Progress notes go to stderr.  Python
standard library only; no network access.
"""
import argparse
import html
import json
import posixpath
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
TEMPLATE = HERE / "report.html"
DEFAULT_REPO = "https://github.com/ajreynol/tachyon"
DEFAULT_URL = "https://ajreynol.github.io/tachyon/elaphros"
LINK = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")
DIRECTION = re.compile(r"^##\s+(E\d+)\s+(.+?)\s*$", re.MULTILINE)
# Each direction states its own risk and gain before it argues for itself. The
# badge is the claim the register makes at a glance, so the page carries it
# rather than a summary somebody here wrote.
EFFORT = re.compile(r"^\*\*Effort\.\*\*\s*(.+?)\s*(?:—|--)", re.MULTILINE | re.DOTALL)
# The vocabulary the planning table states a status in. A row that starts with
# anything else is refused rather than published as an unknown state: the page
# counts what is open, and a status it cannot read is a count it would get wrong.
STATES = ("initial pass complete", "complete", "next", "open")
OPEN_STATES = ("next", "open")


def read(name):
    path = ROOT / name
    if not path.is_file():
        raise ValueError(f"{name}: elaphros no longer has this document")
    return path.read_text()


def section(text, source, heading):
    """The body of one `## heading` section, up to the next `##`."""
    found = re.search(rf"^##\s+{re.escape(heading)}\s*$(.*?)(?=^##\s|\Z)",
                      text, re.MULTILINE | re.DOTALL)
    if not found:
        raise ValueError(f"{source}: no '## {heading}' section to read")
    return found.group(1)


def blob(repo_url, path):
    return f"{repo_url}/blob/main/{path}"


def resolve(repo_url, source, target):
    """A relative Markdown link, as a link into the repository."""
    if target.startswith(("http://", "https://")):
        return target
    if target.startswith("#"):
        return blob(repo_url, source) + target
    return blob(repo_url, posixpath.normpath(posixpath.join(posixpath.dirname(source), target)))


def markup(text, repo_url, source):
    """A Markdown fragment as HTML, escaped first so only these tags survive.

    The input is a tracked document in this repository, and every character is
    escaped before any tag is put back, so nothing in a document can smuggle
    markup onto the page.
    """
    out = html.escape(" ".join(text.split()))
    out = LINK.sub(lambda m: f'<a href="{resolve(repo_url, source, html.unescape(m.group(2)))}">{m.group(1)}</a>', out)
    out = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"`(.+?)`", r"<code>\1</code>", out)
    return re.sub(r"(?<![*\w])\*(?!\s)(.+?)(?<!\s)\*(?![*\w])", r"<em>\1</em>", out)


def rows(body, source, columns):
    """The one Markdown table in `body`, checked against the columns expected."""
    lines = [line.strip() for line in body.splitlines() if line.strip().startswith("|")]
    if len(lines) < 3:
        raise ValueError(f"{source}: expected a table of at least one row")
    cells = [[c.strip() for c in line.strip("|").split("|")] for line in lines]
    header = [c.lower() for c in cells[0]]
    if header != [c.lower() for c in columns]:
        raise ValueError(f"{source}: the table columns are {cells[0]}, not {list(columns)}")
    return [row for row in cells[2:] if len(row) == len(columns)]


def table(header, body_rows, repo_url, source, classes=()):
    """Render a table; `classes` gives a CSS class per column, or none."""
    classes = tuple(classes) + ("",) * (len(header) - len(classes))
    def attr(index):
        return f' class="{classes[index]}"' if classes[index] else ""
    head = "".join(f"<th{attr(i)}>{html.escape(name)}</th>" for i, name in enumerate(header))
    out = [f"<table><thead><tr>{head}</tr></thead><tbody>"]
    for row in body_rows:
        cells = "".join(f"<td{attr(i)}>{value}</td>" for i, value in enumerate(row))
        out.append(f"<tr>{cells}</tr>")
    out.append("</tbody></table>")
    return "\n".join(out)


def state_of(status, source):
    """The state of a planning item, the rest of what it says, and whether it is open.

    The state word becomes a badge, so it is taken off the front of the text
    beside it rather than printed twice.
    """
    plain = status.replace("*", "").strip()
    for word in STATES:
        if plain.lower().startswith(word):
            rest = plain[len(word):].lstrip(" :;,.")
            return word.capitalize(), rest, word in OPEN_STATES
    raise ValueError(f"{source}: planning status {status[:40]!r} starts with none of {list(STATES)}")


def queue(todo, source, repo_url, directions):
    """The ranked directions, each checked against the register it cites."""
    body = section(todo, source, "Agent research priorities")
    ranked = rows(body, source, ("rank", "direction", "why it is here", "next planning step"))
    out, cited = [], []
    for rank, direction, why, step in ranked:
        name = LINK.match(direction.strip())
        if not name:
            raise ValueError(f"{source}: queue row {rank!r} does not link to its direction")
        identifier = name.group(1).split(":")[0].strip()
        if identifier not in directions:
            raise ValueError(f"{source}: the queue ranks {identifier}, which directions.md does not define")
        cited.append(identifier)
        out.append([html.escape(rank), markup(direction, repo_url, source),
                    markup(why, repo_url, source), markup(step, repo_url, source)])
    if len(set(cited)) != len(cited):
        raise ValueError(f"{source}: a direction is ranked twice")
    note = [para for para in body.split("\n\n") if para.strip() and not para.strip().startswith("|")]
    return out, cited, note


def planning(todo, source, repo_url):
    body = section(todo, source, "Planning work")
    out, open_count = [], 0
    for item, status in rows(body, source, ("item", "status / completion condition")):
        label, rest, is_open = state_of(status, source)
        open_count += is_open
        css = "state state-open" if is_open else "state"
        badge = f'<span class="{css}">{html.escape(label)}</span>'
        out.append([markup(item, repo_url, source), f"{badge} {markup(rest, repo_url, source)}"])
    return out, open_count


def guidance(todo, source, repo_url):
    body = section(todo, source, "Maintainer guidance")
    # A bullet may wrap onto following lines; taking only the first would drop
    # whatever sits on the rest of it, which in this document is a link.
    items, collecting = [], False
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith("- "):
            items.append(stripped[2:])
            collecting = True
        elif collecting and stripped and line[:1].isspace():
            items[-1] += " " + stripped
        else:
            collecting = False
    if not items:
        raise ValueError(f"{source}: the maintainer guidance carries no items")
    listed = "".join(f"<li>{markup(item, repo_url, source)}</li>" for item in items)
    tail = [para.strip() for para in body.split("\n\n")
            if para.strip() and not para.strip().startswith("- ")]
    prose = "".join(f'<p class="muted">{markup(para, repo_url, source)}</p>' for para in tail)
    return f"<ul>{listed}</ul>{prose}"


def evidence(index, source, repo_url):
    body = re.split(r"^For source audits", index, flags=re.MULTILINE)[0]
    records = rows(body, source, ("date", "record", "type"))
    if not records:
        raise ValueError(f"{source}: the evidence index lists no records")
    return ([[html.escape(date), markup(record, repo_url, source), markup(kind, repo_url, source)]
             for date, record, kind in records],
            max(date.strip() for date, _, _ in records))


def slug(heading):
    """A heading's anchor, the way the renderer makes one.

    Runs of spaces are *not* collapsed: a heading whose title is separated by an
    em dash loses the dash and keeps both spaces, so its anchor carries a double
    hyphen. Collapsing them produces a link that resolves nowhere, which nothing
    here would catch because these anchors are generated rather than written.
    """
    return re.sub(r"[^\w\s-]", "", heading.lower()).replace(" ", "-")


def register(text, source, repo_url, ranks):
    """Every direction the register defines, with its effort badge and its rank.

    The queue publishes the thirteen that are ranked; this publishes all of
    them, so a reader can see what was left out as well as what was chosen. A
    direction that states no effort is refused rather than shown blank -- the
    badge is the register's own claim, and an empty cell would read as *no
    risk* rather than as *not written down*.
    """
    parts = re.split(r"^##\s+(E\d+\b.*?)\s*$", text, flags=re.MULTILINE)
    rows = []
    for heading, body in zip(parts[1::2], parts[2::2]):
        identifier = heading.split()[0]
        effort = EFFORT.search(body)
        if not effort:
            raise ValueError(f"{source}: {identifier} states no '**Effort.**' risk and gain")
        anchor = slug(heading)
        rank = ranks.get(identifier)
        rows.append([
            f'<a href="{resolve(repo_url, source, "directions.md#" + anchor)}">'
            f"{html.escape(heading)}</a>",
            markup(effort.group(1), repo_url, source),
            html.escape(str(rank)) if rank else '<span class="state state-open">unranked</span>',
        ])
    if not rows:
        raise ValueError(f"{source}: no directions to publish")
    return rows


def retained(source, repo_url):
    """The snapshots beside this script, each counted rather than described.

    `data/README.md` is the register of what is retained; this compares the
    directory to it in both directions. A file the register does not name would
    be published with no account of what it is, and a named file that is gone
    would leave the register describing an artifact nobody can open -- so either
    disagreement is a refusal. The row counts are measured here, which is what
    makes this the report's data and not a directory that merely sits beside it.
    """
    index = read("reports/data/README.md")
    listed = rows(index.split("The upstream SHA")[0], source,
                  ("artifact", "contents"))
    present = {path.name: path for path in sorted((HERE / "data").iterdir())
               if path.is_file() and path.name != "README.md" and not path.name.startswith(".")}
    named, out = set(), []
    for artifact, contents in listed:
        link = LINK.match(artifact.strip())
        if not link:
            raise ValueError(f"{source}: retained artifact {artifact[:40]!r} is not a link to its file")
        name = link.group(2)
        if name not in present:
            raise ValueError(f"{source}: the register names {name}, which is not retained here")
        named.add(name)
        # Lines, not records: two of these carry a header row and one is JSON,
        # so counting lines is the only thing true of all of them.
        lines = sum(1 for _ in present[name].open(encoding="utf-8", errors="replace"))
        out.append([markup(artifact, repo_url, source), f"{lines:,}",
                    markup(contents, repo_url, source)])
    stray = sorted(set(present) - named)
    if stray:
        raise ValueError(f"{source}: {', '.join(stray)} retained here but named by no register row")
    return out


def tile(label, value, note):
    return (f'<div class="tile"><span>{html.escape(label)}</span>'
            f'<strong>{html.escape(str(value))}</strong><span>{html.escape(note)}</span></div>')


def build(out, base_url, repo_url, site_href="../index.html"):
    out = out.resolve()
    if out == ROOT or ROOT in out.parents:
        raise ValueError("the report output must be separate from the project's own documents")
    base_url = base_url.rstrip("/")
    here = "tools/elaphros"

    todo, todo_src = read("docs/todo.md"), f"{here}/docs/todo.md"
    register_text, register_src = read("docs/directions.md"), f"{here}/docs/directions.md"
    record, record_src = read("docs/progress.md"), f"{here}/docs/progress.md"
    index, index_src = read("docs/ledger/README.md"), f"{here}/docs/ledger/README.md"

    directions = [identifier for identifier, _ in DIRECTION.findall(register_text)]
    if not directions:
        raise ValueError(f"{register_src}: no '## E<n>' directions to count")
    if len(set(directions)) != len(directions):
        raise ValueError(f"{register_src}: a direction number is used twice")

    ranked, cited, note = queue(todo, todo_src, repo_url, set(directions))
    register_rows = register(register_text, register_src, repo_url,
                             {name: row + 1 for row, name in enumerate(cited)})
    items, open_items = planning(todo, todo_src, repo_url)
    records, updated = evidence(index, index_src, repo_url)
    snapshots = retained(f"{here}/reports/data/README.md", repo_url)

    lead = re.search(r"^\*\*Updated ([\d-]+)\..*?$", record, re.MULTILINE)
    if not lead:
        raise ValueError(f"{record_src}: no '**Updated <date>.**' line to date the record by")
    questions = rows(record, record_src, ("question", "current evidence"))

    map_rows = rows(section(register_text, register_src, "The map"), register_src,
                    ("part of the problem", "directions", "distinguishing question"))

    tiles = "".join([
        tile("research directions", len(directions), "read from source, none measured"),
        tile("ranked in the queue", len(ranked),
             f"of {len(directions)}; {len(directions) - len(ranked)} are prerequisites or conditional"),
        tile("planning items open", f"{open_items} of {len(items)}", "each with a stated closing condition"),
        tile("retained snapshots", len(snapshots), "counted from the files, not described"),
        tile("measurements", 0, "no experiment has been run"),
    ])

    project_url = blob(repo_url, f"{here}/README.md")
    replacements = {
        "__TITLE__": html.escape("Elaphros reports — what cvc5 pays to produce a proof"),
        "__DESCRIPTION__": html.escape(
            f"Elaphros's research queue: {len(directions)} directions for reducing cvc5's proof-production "
            f"overhead, {len(ranked)} of them ranked, read from source with no measurement yet taken."),
        "__CANONICAL__": html.escape(f"{base_url}/"),
        "__NAV_TITLE__": html.escape("Tachyon / Elaphros"),
        "__SITE_HREF__": html.escape(site_href),
        "__REPO_URL__": html.escape(repo_url),
        "__PROJECT_URL__": html.escape(project_url),
        "__EYEBROW__": html.escape(f"planning · newest record {updated}"),
        "__LEAD__": markup(lead.group(0), repo_url, record_src) + " " + markup(
            "This page publishes the queue itself: what this project thinks is worth investigating, in what "
            "order, and on what source evidence. Every count on it is taken from the documents it links to "
            "while the page is built.", repo_url, record_src),
        "__TILES__": tiles,
        "__MAP__": table(("Part of the problem", "Directions", "Distinguishing question"),
                         [[markup(c, repo_url, register_src) for c in row] for row in map_rows],
                         repo_url, register_src),
        "__QUEUE_NOTE__": " ".join(markup(para, repo_url, todo_src) for para in note[:2]),
        "__QUEUE__": table(("Rank", "Direction", "Why it is here", "Next planning step"),
                           ranked, repo_url, todo_src, classes=("rank", "wrap", "wrap", "wrap")),
        "__UNRANKED__": " ".join(markup(para, repo_url, todo_src) for para in note[2:]),
        "__REGISTER_NOTE__": html.escape(
            f"All {len(directions)} directions, ranked or not. The {len(directions) - len(ranked)} without "
            "a rank are the ones the queue deliberately leaves out: prerequisites that every other entry "
            "depends on, and one that only becomes a priority if a particular corpus is chosen. Risk and "
            "gain are the register's own qualitative priors, argued in the entry rather than measured."),
        "__REGISTER__": table(("Direction", "Risk / gain", "Rank in the queue"),
                              register_rows, repo_url, register_src, classes=("wrap", "", "rank")),
        "__REGISTER_URL__": html.escape(blob(repo_url, f"{here}/docs/directions.md")),
        "__PLANNING__": table(("Item", "Status, and the condition that closes it"), items,
                              repo_url, todo_src, classes=("", "wrap")),
        "__PROGRESS__": table(("Question", "Current evidence"),
                              [[markup(c, repo_url, record_src) for c in row] for row in questions],
                              repo_url, record_src, classes=("", "wrap")),
        "__EVIDENCE__": table(("Date", "Record", "What it establishes"), records, repo_url, index_src),
        "__SNAPSHOTS__": table(("Retained artifact", "Lines", "What it contains"), snapshots,
                               repo_url, f"{here}/reports/data/README.md",
                               classes=("", "rank", "wrap")),
        "__GUIDANCE__": guidance(todo, todo_src, repo_url),
        "__LIMITS__": markup(
            "**Nothing here is a measurement.** No corpus, proof format, checker or overhead target is fixed, "
            "no baseline has been run, and no optimization has been tested. The ranking is an agent's "
            "assessment from reading source, not a maintainer's plan and not an ordering by cost — until the "
            "accounting instrument exists, it is ordered by how much is *known* about each candidate, which "
            "tracks how much source somebody happened to write. The risk and gain badges in the register are "
            "qualitative priors. A direction's presence here is not evidence that changing it would make "
            "anything faster.", repo_url, register_src),
        "__FOOTER__": " ".join(
            f'<a href="{html.escape(href)}">{html.escape(text)}</a>' for text, href in (
                ("The charter", project_url),
                ("The register", blob(repo_url, f"{here}/docs/directions.md")),
                ("The queue", blob(repo_url, f"{here}/docs/todo.md")),
                ("Progress", blob(repo_url, f"{here}/docs/progress.md")),
                ("The ledger", blob(repo_url, f"{here}/docs/ledger/README.md")))),
    }

    body = TEMPLATE.read_text()
    for token, value in replacements.items():
        if token not in body:
            raise ValueError(f"{TEMPLATE.name}: the template no longer has {token}")
        body = body.replace(token, value)

    out.mkdir(parents=True, exist_ok=True)
    (out / "index.html").write_text(body, encoding="utf-8")
    return {
        "name": "elaphros",
        "title": "elaphros",
        "question": "What does producing a proof cost cvc5, and where does that cost go?",
        "summary": f"The research queue: {len(directions)} directions for reducing proof-production overhead, "
                   f"{len(ranked)} of them ranked, each traced to the source evidence behind it. "
                   "No measurement has been taken yet, and the page says so.",
        "href": "index.html",
        "updated": updated,
        # The newest record in the ledger, which is a source audit. Nothing here
        # has been measured, and the index must not say it was.
        "dated": "recorded",
        "headline": [
            {"label": "research directions", "value": str(len(directions)), "note": "read from source"},
            {"label": "ranked in the queue", "value": str(len(ranked)), "note": f"of {len(directions)}"},
            {"label": "measurements", "value": "0", "note": "no experiment has run"},
        ],
        "directions": len(directions),
        "ranked": len(ranked),
        "open": open_items,
        "files": sorted(str(path.relative_to(out)) for path in out.rglob("*") if path.is_file()),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, required=True, help="directory to write the report into")
    parser.add_argument("--base-url", default=DEFAULT_URL, help="where the report will be published")
    parser.add_argument("--repo-url", default=DEFAULT_REPO, help="repository the documents link to")
    parser.add_argument("--site-href", default="../index.html", help="relative link back to the site index")
    args = parser.parse_args()
    try:
        summary = build(args.out, args.base_url, args.repo_url, args.site_href)
    except (OSError, ValueError) as error:
        parser.exit(1, f"report: {error}\n")
    print(json.dumps(summary))
    print(f"report: {summary['directions']} directions, {summary['ranked']} ranked, "
          f"{summary['open']} planning items open -> {args.out.resolve() / 'index.html'}", file=sys.stderr)


if __name__ == "__main__":
    main()
