# machine/user-specific settings: copy job_launcher/site.conf.example -> job_launcher/site.conf
job_launcher/site.conf
# derived baseline and build/run configurations
job_launcher/configs/.gen/
# source documents summarised into tools/*/notes.md are not tracked
*.docx
.DS_Store
__pycache__/
# the published site, built by scripts/build_site.py from tracked evidence
/site/
# working space, never committed
scratch/
*.local.md
# Raw job output: these basename patterns also drive the retention check.
# BEGIN raw job output
results-*.txt
results-*.txt.*
stats-*.txt
stats-*.txt.*
errors-*.txt
errors-*.txt.*
*.log
*.stdout
*.stderr
stdout
stderr
# END raw job output
